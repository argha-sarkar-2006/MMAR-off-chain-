# 3rd-Route Frontend Environment Variables
# Copy this file to .env.local to configure your local environment.
# Never commit real secrets to source control.

# Local Python Backend API URL (default: http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# Auth0 Authentication Configuration
# Obtain these from your Auth0 Dashboard (Application -> Settings)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id
VITE_AUTH0_AUDIENCE=https://api.3rd-route.local
